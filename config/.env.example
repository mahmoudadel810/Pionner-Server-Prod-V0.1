# Server
NODE_ENV=development
PORT=8000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/pionner

# Auth
ACCESS_TOKEN_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me-too
SALT_ROUNDS=10

# URLs used for CORS and links in emails
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:8000
# Extra allowed origins, comma separated (optional)
CORS_ORIGINS=

# Email (optional in development: links and codes are logged instead)
EMAIL_SERVICE=gmail
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Redis (optional) - either a URL or host/port/password
UPSTASH_REDIS_URL=
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
